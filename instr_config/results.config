_normal_client = attacker:auth-lab/client.log : FILE_REGEX : NORMAL_LOGIN_OK
_normal_server = web-server:auth-lab/access.log : FILE_REGEX : AUTH_SUCCESS
_attack_client = attacker:auth-lab/client.log : FILE_REGEX : HTTP_BRUTEFORCE_SENT count=6
_attack_server = web-server:auth-lab/access.log : FILE_REGEX : AUTH_FAILURE
_soc_events = soc:auth-lab/events.json : FILE_REGEX : AUTH_FAILURE
_alert = soc:auth-lab/alerts.log : FILE_REGEX : HTTP_BRUTEFORCE_DETECTED
_soc_block = soc:auth-lab/response.log : FILE_REGEX : SOC_BLOCK_APPLIED
_server_block = web-server:auth-lab/access.log : FILE_REGEX : BLOCK_APPLIED
_client_verify = attacker:auth-lab/client.log : FILE_REGEX : HTTP_BLOCK_VERIFIED
_server_verify = web-server:auth-lab/access.log : FILE_REGEX : AUTH_BLOCKED
